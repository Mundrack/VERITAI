# ─────────────────────────────────────────────────────────────
# SECRETOS — nunca deben entrar al repositorio
# Regla del proyecto: START-HERE §23 "Secretos"
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
**/credentials.json
**/service-account*.json

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# ─────────────────────────────────────────────────────────────
# Node / Vite
# ─────────────────────────────────────────────────────────────
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*

# ─────────────────────────────────────────────────────────────
# Docker / datos locales
# ─────────────────────────────────────────────────────────────
.docker-data/
*.dump
*.sql.gz

# ─────────────────────────────────────────────────────────────
# Artefactos de investigación descargados (evidencia cruda)
# Se versiona el registro, no el binario descargado.
# ─────────────────────────────────────────────────────────────
research/raw/
research/**/*.tmp

# ─────────────────────────────────────────────────────────────
# Sistema operativo / editores
# ─────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
~$*

# Arte conceptual de marca (Mateo, 2026-10-03): no entra en el repositorio.
# Los recursos de verdad son los SVG de apps/web/src/presentacion/marca/ y los
# PNG que genera `npm run iconos` en apps/web/src/extension/iconos/.
/VeritAI_*.zip
/VeritAI_*.html
/icono-*.png
