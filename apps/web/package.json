{
  "name": "veritai-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panel de UI de VERITAI. TypeScript sin framework: el mismo codigo se empaqueta despues como extension MV3.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ver": "vitest",
    "test:cobertura": "vitest run --coverage",
    "iconos": "node scripts/generar-iconos.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
