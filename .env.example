# =============================================================================
# VERITAI - Plantilla de variables de entorno
# =============================================================================
# Este archivo SI se versiona. Solo contiene marcadores, nunca secretos reales.
#
# Para generar tu .env local con contrasenas aleatorias:
#     PowerShell : .\scripts\init-env.ps1
#     Bash       : ./scripts/init-env.sh
#
# El archivo .env resultante esta en .gitignore y no debe subirse jamas.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
VERITAI_ENV=local
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL - contenedor local
# -----------------------------------------------------------------------------
# Al migrar a Supabase este bloque deja de usarse: el servicio "db" se apaga y
# solo sobreviven las dos DATABASE_URL de mas abajo.
POSTGRES_DB=veritai
POSTGRES_USER=veritai_migrator
POSTGRES_PASSWORD=GENERAR_CON_init-env
# Puerto en el HOST. Se usa 55432 y no 5432 porque es habitual tener ya un
# PostgreSQL instalado en la maquina ocupando el 5432. Dentro de la red de
# Docker el puerto sigue siendo 5432, asi que DATABASE_URL no cambia.
POSTGRES_PORT=55432

# -----------------------------------------------------------------------------
# Usuario de aplicacion - principio de minimo privilegio (START-HERE 23 y 25)
# -----------------------------------------------------------------------------
# La API NUNCA se conecta con el usuario que aplica migraciones.
VERITAI_APP_DB_USER=veritai_app
VERITAI_APP_DB_PASSWORD=GENERAR_CON_init-env

# -----------------------------------------------------------------------------
# CONEXIONES - unico punto de cambio para migrar a Supabase
# -----------------------------------------------------------------------------
# El codigo de la aplicacion solo conoce estas dos variables. No importa si
# apuntan a un contenedor local o a un proyecto Supabase.
#
#   local     -> postgresql+psycopg://veritai_app:...@db:5432/veritai
#   Supabase  -> postgresql+psycopg://postgres.<ref>:...@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Detalle completo en: migracion-supabase-base-de-datos/03-VARIABLES-DE-ENTORNO.md
DATABASE_URL=postgresql+psycopg://veritai_app:GENERAR_CON_init-env@db:5432/veritai
DATABASE_URL_MIGRATOR=postgresql+psycopg://veritai_migrator:GENERAR_CON_init-env@db:5432/veritai

# Pool de conexiones. En Supabase con pooler en modo transaction hay que
# desactivar el pool del lado del cliente (ver 02-DIFERENCIAS-LOCAL-VS-SUPABASE.md).
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_USE_POOL=true

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=8000
# Lista blanca de origenes CORS, separada por comas. Nunca usar "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_DEFAULT_LOCALE=es
